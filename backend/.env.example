# Copy this file to .env (never commit .env) and add ONE key.

# --- Google Gemini (free key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- or Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# LLM_PROVIDER=auto              # auto (Gemini if its key is set) | gemini | anthropic
# GEMINI_MODEL=gemini-2.5-flash  # any model id shown in Google AI Studio
# GEMINI_THINKING_BUDGET=0       # 0 = faster, less "thinking" (Flash models)
# ANTHROPIC_MODEL=claude-sonnet-5
# DATABASE_URL=sqlite:///./briefly.db
# STORAGE_DIR=storage
# MOCK_TEAMS_DIR=app/mock_teams
# MAX_UPLOAD_BYTES=10485760
# Comma-separated browser origins allowed to call the API (add your Vercel URL)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
